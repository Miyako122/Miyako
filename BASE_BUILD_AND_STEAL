CreateHeader("COMBAT & STEAL MODULES")

local killauraActive = false
local attackLoop = nil

local function getClosestEnemy()
    local closestDist = 15
    local closestPlayer = nil
    
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = myChar.HumanoidRootPart.Position

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
            local hum = v.Character:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local dist = (v.Character.HumanoidRootPart.Position - myPos).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closestPlayer = v
                end
            end
        end
    end
    return closestPlayer
end

CreateToggle("⚔️ Auto Hit (Wajib pegang tongkat)", function(state)
    killauraActive = state
    
    if killauraActive then
        attackLoop = task.spawn(function()
            local remote = ReplicatedStorage:FindFirstChild("RemoteEvent")
            while killauraActive do
                task.wait(0.2)
                local target = getClosestEnemy()
                local toolEquipped = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                
                if target and remote and toolEquipped then
                    pcall(function()
                        remote:FireServer("gear_swing", LocalPlayer.UserId)
                        task.wait(0.05)
                        remote:FireServer("gear_hit_claim", target.UserId, target)
                    end)
                end
            end
        end)
    else
        if attackLoop then task.cancel(attackLoop) end
    end
end)

