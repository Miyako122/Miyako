local function GetPlayerMoney()
    local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pGui then return 0 end
    for _, guiElement in ipairs(pGui:GetDescendants()) do 
        if guiElement:IsA("TextLabel") and guiElement.Text:find("RP") then 
            local moneyStr = guiElement.Text:match("RP%s*([%d,]+)")
            if moneyStr then return tonumber(moneyStr:gsub(",", "")) or 0 end 
        end 
    end
    return 0 
end

local function GetEquippedRod()
    local char = LocalPlayer.Character
    if not char then return nil end
    for _, tool in ipairs(char:GetChildren()) do 
        if tool:IsA("Tool") and tool.Name:lower():find("rod") then return tool end 
    end
    return nil 
end

local function BuyShopItem(shopType, itemName)
    local targetFunc = RemoteFunctionFolder:WaitForChild(shopType)
    local s, r = pcall(function() return targetFunc:InvokeServer("Buy", itemName) end)
    return s and r == "success" 
end

local function ExecuteAutoSell()
    local activeFilter = _G.DVHub.Flags.SellFilter or "Sell All"
    local filterMap = {
        ["Sell All"] = "Sell All", ["Keep Favorites"] = "Keep Favorites",
        ["Under 50 Kg"] = "All under 50 Kg", ["Under 100 Kg"] = "All under 100 Kg",
        ["Under 400 Kg"] = "All under 400 Kg", ["Under 600 Kg"] = "All under 600 Kg"
    }
    
    if activeFilter == "Keep Favorites" then 
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChild("Humanoid")
        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        if not hum or not backpack then return false end
        
        local fishList = {}
        for _, tool in ipairs(backpack:GetChildren()) do 
            if tool:IsA("Tool") and tool.Name:lower():find("ikan") and not tool.Name:lower():find("favorite") then 
                table.insert(fishList, tool)
            end 
        end
        
        for _, fishTool in ipairs(fishList) do 
            if not fishTool or not fishTool.Parent then continue end
            hum:EquipTool(fishTool)
            task.wait(0.1)
            -- Bypass checking, langsung jual untuk kecepatan maksimal
            pcall(function() SellFishFunc:InvokeServer("SellFish", "Sell this fish") end)
            task.wait(0.05)
        end
        
        local prevRod = nil
        local newBackpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        if newBackpack then 
            for _, tool in ipairs(newBackpack:GetChildren()) do 
                if tool:IsA("Tool") and tool.Name:lower():find("rod") then prevRod = tool; break end 
            end 
        end
        if prevRod and hum then hum:EquipTool(prevRod) end
        return true 
    end
    
    local mappedFilter = filterMap[activeFilter] or "Sell All"
    -- Bypass checking
    local finalSell = pcall(function() return SellFishFunc:InvokeServer("SellFish", mappedFilter) end)
    return finalSell 
end

local function ExecuteAutoSellCrystal()
    -- Bypass checking, langsung jual semua kristal
    local fS = pcall(function() return SellCrystalFunc:InvokeServer("SellCrystal", "Sell All") end)
