local ExecBtn = Instance.new("TextButton", ContentArea)
ExecBtn.Size = UDim2.new(1, 0, 0, 38)
ExecBtn.BackgroundColor3 = AccentColor
ExecBtn.Text = "🔨 EKSEKUSI PEMBANGUNAN"
ExecBtn.TextColor3 = Color3.fromRGB(10, 10, 10)
ExecBtn.Font = Enum.Font.GothamBlack
ExecBtn.TextSize = 12
Instance.new("UICorner", ExecBtn).CornerRadius = UDim.new(0, 6)

ExecBtn.MouseButton1Click:Connect(function()
    if currentPlotID == 0 then
        ExecBtn.Text = "⚠️ VERIFIKASI ID DULU!"
        task.delay(2, function() ExecBtn.Text = "🔨 EKSEKUSI PEMBANGUNAN" end)
        return
    end

    if not activeBlueprintData then
        ExecBtn.Text = "⚠️ CEK PLOT DULU!"
        task.delay(2, function() ExecBtn.Text = "🔨 EKSEKUSI PEMBANGUNAN" end)
        return
    end

    local buildRemote = ReplicatedStorage:FindFirstChild("RemoteEvent", true)
    if not buildRemote then return end

    ExecBtn.Text = "⏳ MEMBANGUN..."
    
    task.spawn(function()
        for layer = 0, tinggiTembok - 1 do
            for _, baseCFrame in ipairs(activeBlueprintData) do
                local targetCFrame = baseCFrame + Vector3.new(0, layer * 4, 0)
                local args = {
                    [1] = "placeblock", 
                    [2] = currentPlotID, 
                    [3] = currentBlock, 
                    [4] = targetCFrame, 
                    [5] = {}
                }
                buildRemote:FireServer(unpack(args))
                task.wait(0.02)
            end
        end
        ExecBtn.Text = "✅ SELESAI!"
        task.delay(3, function() ExecBtn.Text = "🔨 EKSEKUSI PEMBANGUNAN" end)
    end)
end)

-- HOOK PENYADAP ID SANGAT RINGAN
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    
    if getPlotIDActive and not checkcaller() and (method == "InvokeServer" or method == "FireServer") then
        local args = {...}
        if type(args[1]) == "string" and (args[1] == "placeblock" or args[1] == "PlaceBlock") then
            local detectedID = tonumber(args[2])
            if detectedID then
                currentPlotID = detectedID
                getPlotIDActive = false
                verifiedIDReady = true
            end
        end
    end
    return oldNamecall(self, ...)
end)

task.spawn(function()
    while task.wait(0.2) do
        if verifiedIDReady then
            verifiedIDReady = false
            SpyBtn.Text = "📡 ID DETECTED: " .. tostring(currentPlotID)
            SpyBtn.TextColor3 = AccentColor
            pcall(function() setclipboard(tostring(currentPlotID)) end)
        end
    end
end)
