-- FUNGSI HIT TOMBOL MOBILE & PC (FIX FREEZE LAYAR HP)
local function hitSkillCheck()
    pcall(function()
        local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or PlayerGui
        local mobile = pGui and pGui:FindFirstChild("Survivor-mob")
        local controls = mobile and mobile:FindFirstChild("Controls")
        local action = controls and controls:FindFirstChild("action")
        -- Tombol target valid di mobile adalah 'check' atau 'action'
        local btn = action and (action:FindFirstChild("check") or action)
        
        if btn and btn:IsA("GuiObject") and btn.Visible then
            if firesignal then
                -- Cukup gunakan firesignal agar tidak mengunci/mengganggu sentuhan kamera layar HP
                pcall(function() firesignal(btn.MouseButton1Down) end)
                task.wait(0.008)
                pcall(function() firesignal(btn.MouseButton1Up) end)
                pcall(function() firesignal(btn.Activated) end)
            else
                -- SendTouchEvent hanya sebagai cadangan jika firesignal tidak ada
                local p = btn.AbsolutePosition
                local s = btn.AbsoluteSize
                local i = game:GetService("GuiService"):GetGuiInset()
                local cx = p.X + (s.X / 2) + i.X
                local cy = p.Y + (s.Y / 2) + i.Y
                VirtualInputManager:SendTouchEvent(8822, 0, cx, cy)
                task.wait(0.008)
                VirtualInputManager:SendTouchEvent(8822, 2, cx, cy)
            end
        else
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
            task.wait(0.008)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        end
    end)
end
