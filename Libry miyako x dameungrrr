                Size = UDim2.new(0, 56, 0, 56),
                BackgroundTransparency = 0,
                TextTransparency = 0
            }):Play()
            TweenService:Create(FloatStroke, TweenInfo.new(0.4), {Transparency = 0.1}):Play()
        end
    end)

    FloatingButton.MouseButton1Up:Connect(function()
