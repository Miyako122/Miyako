            TweenService:Create(FloatingButton, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 0, 0, 0),
                BackgroundTransparency = 1,
                TextTransparency = 1
            }):Play()
            TweenService:Create(FloatStroke, TweenInfo.new(0.3), {Transparency = 1}):Play()
            
            task.delay(0.3, function()
                FloatingButton.Visible = false
                MainFrame.Visible = true
