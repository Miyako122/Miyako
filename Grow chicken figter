                            task.wait(1) 
                        end
                    end
                    lastHealth = hum.Health 
                    
                    if scrapCount < maxScrap then
                        local closest = nil
                        local closestDist = 1500
                        for _, obj in ipairs(Workspace:GetDescendants()) do
                            if obj.Name == "Loose" or (obj.Parent and obj.Parent.Name == "PitScrap") then
                                if obj:IsA("BasePart") and obj.Position then
                                    local dist = (obj.Position - root.Position).Magnitude
                                    if dist < closestDist then closest = obj; closestDist = dist end
                                end
                            end
                        end
                        
                        if closest and getgenv().MiyakoRecycleRunning then
                            if currentMode == "Terbang" then flyTo(closest.Position, false) else walkSmartAI(closest.Position) end
                            
                            local timeout = 0
                            local originParent = closest.Parent
                            while closest and closest.Parent == originParent and timeout < 10 and getgenv().MiyakoRecycleRunning do
                                if currentMode == "Jalan" then 
                                    hum:MoveTo(closest.Position) 
                                else
                                    if closest:IsA("BasePart") then
                                        firetouchinterest(root, closest, 0)
                                        firetouchinterest(root, closest, 1)
                                    end
                                end
                                task.wait(0.1)
                                timeout = timeout + 1
                            end
                            
                            if timeout < 10 then
                                scrapCount = scrapCount + 1
                                CounterText.Text = "Besi Terkumpul: " .. scrapCount .. " / " .. maxScrap
                            end
                        end
                    else
                        local recyclerUI = Workspace:FindFirstChild("Recyclers") and Workspace.Recyclers:FindFirstChild("RecyclerUI")
                        if recyclerUI and root and getgenv().MiyakoRecycleRunning then
                            local targetPos = (recyclerUI:IsA("BasePart") and recyclerUI.Position or recyclerUI:GetPivot().Position)
                            
                            if currentMode == "Terbang" then
                                local centerPit = Vector3.new(8, root.Position.Y, -2)
                                local distFromCenter = (root.Position * Vector3.new(1,0,1) - centerPit * Vector3.new(1,0,1)).Magnitude
                                if distFromCenter < 50 then
                                    local dirKeluar = (root.Position * Vector3.new(1,0,1) - centerPit * Vector3.new(1,0,1)).Unit
                                    if dirKeluar.Magnitude ~= dirKeluar.Magnitude then dirKeluar = Vector3.new(1,0,0) end
                                    local exitPos = centerPit + (dirKeluar * 60)
                                    exitPos = Vector3.new(exitPos.X, targetPos.Y, exitPos.Z)
