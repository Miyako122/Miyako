                    if not char or not char.Parent then scrapCount = 0; task.wait(1); continue end
                    
                    local root = char:FindFirstChild("HumanoidRootPart")
                    local hum = char:FindFirstChild("Humanoid")
                    if not root or not hum then scrapCount = 0; task.wait(1); continue end
                    
                    -- [PERBAIKAN BUG DROP BESI]
                    -- Hanya drop besi jika karakter benar-benar mati (Health <= 0)
                    if hum.Health <= 0 then
