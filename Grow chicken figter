    local function flyTo(targetPos, isSelling)
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        if not root or not hum then return end
        
        local activeSpeed = speedConfig[currentSpeed] 
        local dest = targetPos + (isSelling and Vector3.new(0, 1.5, 0) or Vector3.new(0, -1.2, 0))
        local startPos = root.Position
        local totalDist = (startPos - dest).Magnitude
        
        if totalDist > 12 then
            local stepSize = 12 
            local steps = math.ceil(totalDist / stepSize)
            local direction = (dest - startPos).Unit
            for i = 1, steps do
                if not getgenv().MiyakoRecycleRunning then break end
                local nextPos = startPos + (direction * math.min(i * stepSize, totalDist))
                local distStep = (root.Position - nextPos).Magnitude
                local timeStep = math.max(distStep / activeSpeed.Divisor, 0.05)
                
                local tween = TweenService:Create(root, TweenInfo.new(timeStep, Enum.EasingStyle.Linear), {CFrame = CFrame.new(nextPos)})
                root.AssemblyLinearVelocity = Vector3.new(0, -0.1, 0) 
                tween:Play()
                tween.Completed:Wait()
                task.wait(activeSpeed.Delay) 
            end
        else
            local timeToMove = math.max(totalDist / activeSpeed.Divisor, 0.05)
            local tween = TweenService:Create(root, TweenInfo.new(timeToMove, Enum.EasingStyle.Linear), {CFrame = CFrame.new(dest)})
            root.AssemblyLinearVelocity = Vector3.new(0, -0.1, 0)
            tween:Play()
            tween.Completed:Wait()
        end
    end

    local function walkSmartAI(targetPos)
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        if not root or not hum then return end
        
        local path = PathfindingService:CreatePath({AgentRadius = 2, AgentHeight = 5, AgentCanJump = true})
        local success, _ = pcall(function() path:ComputeAsync(root.Position, targetPos) end)

        if success and path.Status == Enum.PathStatus.Success then
            local waypoints = path:GetWaypoints()
            for i = 2, #waypoints do
                if not getgenv().MiyakoRecycleRunning then break end
                local wp = waypoints[i]
                if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
                hum:MoveTo(wp.Position)
                
                local timeout = 0
                while timeout < 30 and getgenv().MiyakoRecycleRunning do
                    local dist = (root.Position * Vector3.new(1,0,1) - wp.Position * Vector3.new(1,0,1)).Magnitude
                    if dist < 4 then break end
                    task.wait(0.1)
                    timeout = timeout + 1
                end
            end
        else
            hum:MoveTo(targetPos)
            local timeout = 0
            while timeout < 50 and getgenv().MiyakoRecycleRunning do
                local dist = (root.Position * Vector3.new(1,0,1) - targetPos * Vector3.new(1,0,1)).Magnitude
                if dist < 6 then break end
                task.wait(0.1)
                timeout = timeout + 1
            end
        end
    end

