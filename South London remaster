function StartFarming()
    isFarming = true
    farmThread = task.spawn(function()
        while isFarming do
            for i = 1, 10 do
                if not isFarming then break end
                
                local spill = SpillSystem:FindFirstChild("spill" .. i)
                if spill then
                    TeleportAndPressPrompt(spill)
                    task.wait(0.7)
                end
            end
            task.wait(1)
        end
    end)
end

function StopFarming()
    isFarming = false
    if farmThread then
        pcall(task.cancel, farmThread)
        farmThread = nil
    end
    SetFarmingState(false)
end

GenerateButton.MouseButton1Click:Connect(function()
    if isFarming then
        StopFarming()
    else
        SetFarmingState(true)
        StartFarming()
    end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.P and isFarming then
        if farmThread then
            pcall(task.cancel, farmThread)
        end
        Tween(GenerateButton, TweenQuick, { BackgroundColor3 = Theme.Accent })
        ButtonIcon.Text = "⚡"
        ButtonLabel.Text = "GASS"
        UpdateStatus("Ready to Generate", Theme.Text, Theme.Green)
    end
end)

-- ===== DRAG SYSTEM =====
local isDragging = false
local dragStart = nil
local cardStartPos = nil
local dragConnection = nil
local dragEndConnection = nil

-- Function to start dragging
local function startDrag(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isDragging = true
        dragStart = input.Position
        cardStartPos = Card.Position
        
        -- Disable button clicks while dragging
        GenerateButton.Active = false
        
        -- Create connections for drag movement and end
        dragConnection = UserInputService.InputChanged:Connect(function(inputChanged)
            if isDragging and inputChanged.UserInputType == Enum.UserInputType.MouseMovement then
                local delta = inputChanged.Position - dragStart
                Card.Position = UDim2.new(
                    cardStartPos.X.Scale,
                    cardStartPos.X.Offset + delta.X,
                    cardStartPos.Y.Scale,
                    cardStartPos.Y.Offset + delta.Y
                )
            end
        end)
        
        dragEndConnection = UserInputService.InputEnded:Connect(function(inputEnded)
            if inputEnded.UserInputType == Enum.UserInputType.MouseButton1 and isDragging then
                isDragging = false
                GenerateButton.Active = true
                
                -- Clean up connections
                if dragConnection then
                    dragConnection:Disconnect()
                    dragConnection = nil
                end
                if dragEndConnection then
                    dragEndConnection:Disconnect()
                    dragEndConnection = nil
                end
            end
        end)
    end
end

-- Connect drag start to the Card (entire card is draggable)
Card.InputBegan:Connect(startDrag)

-- Also allow dragging from the header area
Header.InputBegan:Connect(startDrag)

-- Prevent interaction with buttons from triggering drag
GenerateButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        -- Stop any ongoing drag when clicking the button
        if isDragging then
            isDragging = false
            if dragConnection then
                dragConnection:Disconnect()
                dragConnection = nil
            end
            if dragEndConnection then
                dragEndConnection:Disconnect()
                dragEndConnection = nil
            end
        end
    end
end)

-- ===== END DRAG SYSTEM =====

function TeleportAndPressPrompt(spill)
    local prompt = spill:FindFirstChildWhichIsA("ProximityPrompt")
    if not prompt then
        prompt = spill:FindFirstChild("Spill")
    end
    
    if prompt and prompt.Enabled then
        local position = spill.CFrame.Position
        local target = Vector3.new(position.X, position.Y + 3, position.Z)
        
        HumanoidRootPart.CFrame = CFrame.new(target)
        task.wait(0.15)
        prompt:InputHoldBegin(Enum.UserInputType.Keyboard)
        task.wait(0.1)
        prompt:InputHoldEnd(Enum.UserInputType.Keyboard)
    end
end

