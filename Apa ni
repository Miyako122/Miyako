local isManualStealing = false

local function findHRP()
    return LP.Character and (LP.Character:FindFirstChild("HumanoidRootPart") or LP.Character.PrimaryPart)
end

local function GetLocalPlotCenter()
    local plotObj = PlotState and PlotState.ResolvePlot and PlotState.ResolvePlot()
    local pt = plotObj and plotObj.CenterPoint and (typeof(plotObj.CenterPoint) == "Vector3" and plotObj.CenterPoint or plotObj.CenterPoint.Position)
    if pt then return Vector3.new(pt.X, math.max(pt.Y, 70.4), pt.Z) end
    return Vector3.new(464.7, 70.4, -364.0)
end

local SAFE_ZONE_POS = Vector3.new(464.7, 70.4, -364.0)

local function isEggInField(checkUid)
    local s, data = pcall(EggState.ReadFieldEggs)
    if s and data and data.Records then
        for _, r in ipairs(data.Records) do
            if r.Uid == checkUid and r.State == "Slot" then return true end
        end
    end
    return false
end

local function fireProximity(targetPos, distance)
    local hrp = findHRP()
    if not hrp then return end
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") and (d.Name == "CarryAreaEgg" or d.ActionText == "Steal") then
            if d.Parent and (d.Parent.Position - targetPos).Magnitude < distance then
                d.HoldDuration = 0
                pcall(function() fireproximityprompt(d) end)
            end
        end
    end
end

local function getDecoyEgg(targetUid)
    local s, data = pcall(EggState.ReadFieldEggs)
    if not s or not data or not data.Records then return nil end
    local decoy, minDist = nil, math.huge
    local hrp = findHRP()
    if not hrp then return nil end
    
    for _, rec in ipairs(data.Records) do
        if rec.Uid ~= targetUid and rec.State == "Slot" and (rec.AreaId == "Forest" or rec.AreaId == "Lake") and rec.BoundsCFrame then
            local dist = (rec.BoundsCFrame.Position - hrp.Position).Magnitude
            if dist < minDist then
                minDist = dist
                decoy = {
                    Uid = rec.Uid,
                    Pos = rec.BoundsCFrame.Position,
                    SlotKey = rec.FirstAreaSlotKey or rec.SlotKey or "Forest:Slot_002"
                }
            end
        end
    end
    return decoy
end

local function StealEggManual(targetUid, targetPos, targetSlotKey, targetArea)
    if isManualStealing then return end
    isManualStealing = true
    
    task.spawn(function()
        local hum = LP.Character and LP.Character:FindFirstChild("Humanoid")
        local hrp = findHRP()
        local coreGui = game:GetService("StarterGui")
        local net = RS:FindFirstChild("Packages") and RS.Packages:FindFirstChild("Networking")
        local carryRemote = net and net:FindFirstChild("RF/EggWorld/AskFieldEggCarry")
        
        if not hum or not hrp or not carryRemote then isManualStealing = false; return end

        local function notify(msg)
            pcall(function() coreGui:SetCore("SendNotification", {Title="MIYAKO STEAL ANN EGG", Text=msg, Duration=3}) end)
        end

        local isFarTarget = (targetArea ~= "Forest" and targetArea ~= "Lake")

        if isFarTarget then
            -- ------------------------------------------------------------------
            -- FASE 1: LARI KE UMPAN AYAM
            -- ------------------------------------------------------------------
            local decoyEgg = getDecoyEgg(targetUid)
            if not decoyEgg then
                notify("❌ Tidak ada umpan di map! Tunggu sebentar.")
                isManualStealing = false
                return
            end

            notify("1. Berlari menuju ayam umpan...")
            
            hum.WalkSpeed = 350
            local runToDecoyT0 = os.clock()
            while (decoyEgg.Pos - hrp.Position).Magnitude > 5 and (os.clock() - runToDecoyT0 < 5) do
                hum:MoveTo(decoyEgg.Pos)
                task.wait(0.1)
            end
            
            -- ------------------------------------------------------------------
            -- FASE 2: AMBIL UMPAN & TUNGGU 3 DETIK (MUTLAK)
            -- ------------------------------------------------------------------
            notify("2. Mengambil umpan & Menunggu 3 detik...")
            
            local grabDecoyT0 = os.clock()
            -- Spam ambil selama maksimal 2 detik atau sampai telur nempel
            while isEggInField(decoyEgg.Uid) and (os.clock() - grabDecoyT0 < 2) do
                hrp.CFrame = CFrame.new(decoyEgg.Pos + Vector3.new(0, 1.2, 0))
                pcall(function() carryRemote:InvokeServer({ Uid = decoyEgg.Uid, FirstAreaSlotKey = decoyEgg.SlotKey }) end)
                fireProximity(hrp.Position, 25)
                
                if LP.Character:FindFirstChild("EggModel") or LP.Character:FindFirstChild("CarryItem") then
                    break
                end
                task.wait(0.1)
            end

            -- WAKTU TUNGGU MUTLAK 3 DETIK (Sesuai instruksi untuk mengatasi bug ragdoll delay)
            task.wait(3)
        end

        -- ----------------------------------------------------------------------
        -- FASE 3: INSTAN TP, STABILISASI (ANCHOR) & VALIDASI TELUR TARGET
        -- ----------------------------------------------------------------------
        notify("3. Waktu habis! Instant Lock ke Target...")
        
        -- KUNCI FISIKA: Cegah karakter jatuh, terlempar, atau membawa momentum kecepatan
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        
        -- BEKUKAN KARAKTER (ANCHOR) AGAR TIDAK JATUH TERJEREMBAB ATAU MASUK TANAH
        hrp.Anchored = true
        
        -- TP DENGAN TINGGI AMAN (+2 STUDS DARI TANAH)
        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
        task.wait(0.2) -- Biarkan posisi tersinkron ke server dengan stabil
        
        -- LEPAS BEKU (UNANCHOR) DAN PAKSA MENDARAT AGAR ANIMASI NORMAL
        hrp.Anchored = false
        hum.PlatformStand = false
        hum.Sit = false
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Landed) end)
        task.wait(0.1)
        
        local targetGrabbed = false
        local grabTargetT0 = os.clock()
        
        -- Coba ambil telur target
        while isEggInField(targetUid) and (os.clock() - grabTargetT0 < 5) do
            hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
            
            local payload = { Uid = targetUid }
            if targetSlotKey then
                payload.FirstAreaSlotKey = targetSlotKey
                payload.SlotKey = targetSlotKey
            end
            
            pcall(function() carryRemote:InvokeServer(payload) end)
            fireProximity(hrp.Position, 30)
            
            -- CEK MUTLAK: Jika telur benar-benar sudah nempel di karakter, break loop
            if LP.Character:FindFirstChild("EggModel") or LP.Character:FindFirstChild("CarryItem") then
                targetGrabbed = true
                break
            end
            
            task.wait(0.1)
        end

        if not targetGrabbed then
            notify("⚠️ Gagal! Telur target tidak berhasil diangkat.")
            isManualStealing = false
            return
        end

        -- ----------------------------------------------------------------------
        -- FASE 4: BERLARI SPRINT KE BASE PLOT SENDIRI (ANTI-RESET SPEED)
        -- ----------------------------------------------------------------------
        notify("4. Telur di tangan! Sprint 450 Speed...")
        local plotTarget = GetLocalPlotCenter()
        local runT0 = os.clock()
        
        while (plotTarget - hrp.Position).Magnitude > 15 and (os.clock() - runT0 < 10) do
            hum.WalkSpeed = 450 
            hum:MoveTo(plotTarget)
            
            -- Cegah ragdoll reset saat berlari (mengatasi bug jatuh bangun saat lari)
            if hum:GetState() == Enum.HumanoidStateType.Ragdoll or hum:GetState() == Enum.HumanoidStateType.FallingDown or hum:GetState() == Enum.HumanoidStateType.Freefall then
                hum.PlatformStand = false
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
            end
            
            -- Jika di tengah jalan telurnya hilang/lepas, batalkan lari
            if not (LP.Character:FindFirstChild("EggModel") or LP.Character:FindFirstChild("CarryItem")) then
                break
            end
            
            task.wait(0.05)
        end

        hum.WalkSpeed = 16
        hum:MoveTo(hrp.Position)
        notify("✅ Aman di Plot Sendiri!")
        isManualStealing = false
    end)
end

