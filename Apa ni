task.spawn(function()
    while task.wait(1.5) do
        if not sg.Parent or ACTIVE_TAB ~= "main" then continue end
        
        for _, child in ipairs(RadarScroll:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        
        if not EggState or not EggState.ReadFieldEggs then continue end
        local ok, snap = pcall(EggState.ReadFieldEggs)
        if not ok or not snap or not snap.Records then continue end
        
        local activeEggs = {}
        for _, record in ipairs(snap.Records) do
            if record.State == "Slot" and record.BoundsCFrame then
                local areaName = record.AreaId or "Unknown"
                if SELECTED_MAPS[areaName] then
                    local rName = record.Rarity or "Common"
                    if type(rName) == "table" then rName = rName.DisplayName or rName.Name or rName._id or "Common" end
                    local val = RarityScores[rName] or 1
                    
                    local scale = tonumber(record.AssetScale) or 1
                    local nestScale = tonumber(record.NestScale) or 1
                    local isBig = (scale >= 1.35 or nestScale >= 1.0)
                    
                    local petCat = record.AssetCategory or record.Name or "Unknown"
                    local iconId = ""
                    if AssetsData then
                        local dir = AssetsData.Directory or AssetsData
                        if dir[petCat] then iconId = dir[petCat].Icon or (dir[petCat].Egg and dir[petCat].Egg.Icon) or "" end
                    end
                    
                    local slotKey = record.FirstAreaSlotKey or record.SlotKey or record.Key or (record.AreaId and record.SlotId and (record.AreaId .. ":" .. record.SlotId))
                    
                    table.insert(activeEggs, {
                        Uid = record.Uid, 
                        Pos = record.BoundsCFrame.Position,
                        Name = petCat, 
                        Icon = iconId, 
                        RarityName = rName, 
                        Value = val, 
                        IsBig = isBig, 
                        Area = areaName,
                        SlotKey = slotKey
                    })
                end
            end
        end
        
        table.sort(activeEggs, function(a, b) return a.Value > b.Value end)
        
        for _, egg in ipairs(activeEggs) do
